@model IEnumerable<GestaoConsultasUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<h1>Minhas Consultas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova Consulta</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Especialidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataHora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Especialidade)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataHora)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>    